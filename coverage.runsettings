<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>
            [Wrapster.Api]*,
            [*]Program,
            [*]*DependencyInjection,
            [Wrapster.Infrastructure]Wrapster.Infrastructure.Persistence.*,
            [Wrapster.Infrastructure]Wrapster.Infrastructure.Migrations.*,
            [Wrapster.Infrastructure]Wrapster.Infrastructure.Email.*,
            [Wrapster.Infrastructure]Wrapster.Infrastructure.Queue.*,
            [Wrapster.Infrastructure]Wrapster.Infrastructure.Configuration.*,
            [Wrapster.Infrastructure]Wrapster.Infrastructure.Authentication.KeycloakClaimsTransformation,
            [Wrapster.Infrastructure]Wrapster.Infrastructure.Authentication.MultiTenantJwtBearerEvents,
            [Wrapster.Infrastructure]Wrapster.Infrastructure.Authentication.RealmConfigurationCache,
            [*]System.Runtime.CompilerServices.*,
            [*]Microsoft.AspNetCore.OpenApi.Generated.*
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
