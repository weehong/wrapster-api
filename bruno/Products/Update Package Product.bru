meta {
  name: Update Package Product
  type: http
  seq: 16
}

put {
  url: {{BASE_URL}}/api/v1/products/:id?tenantId={{PARTNER_TENANT_ID}}
  body: json
  auth: bearer
}

params:path {
  id: {{PRODUCT_ID}}
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "name": "Carton of 12 (Updated)",
    "skuCode": "SKU-PACK-1",
    "cost": 52.99,
    "lowStockThreshold": 5,
    "unpackTargetProductId": "<existing-single-product-guid>",
    "unpackQuantityPerPackage": 12
  }
}
