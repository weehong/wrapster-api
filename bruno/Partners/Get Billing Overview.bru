meta {
  name: Get Billing Overview
  type: http
  seq: 6
}

get {
  url: {{BASE_URL}}/api/v1/partners/billing/overview
  body: none
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

docs {
  Owner-only. Returns one row per (partner x billable feature) with stock report
  billing status, prorated amount due when inactive, and access dates.
}
