meta {
  name: Retry Partner Provisioning
  type: http
  seq: 5
}

post {
  url: {{BASE_URL}}/api/v1/partners/:tenantId/retry
  body: json
  auth: bearer
}

params:path {
  tenantId: {{PARTNER_TENANT_ID}}
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "adminEmail": "{{PARTNER_ADMIN_EMAIL}}",
    "adminUsername": "{{PARTNER_ADMIN_USERNAME}}",
    "temporaryPassword": "{{PARTNER_ADMIN_PASSWORD}}",
    "isTemporaryPassword": true
  }
}
