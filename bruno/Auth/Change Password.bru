meta {
  name: Change Password
  type: http
  seq: 7
}

post {
  url: {{BASE_URL}}/api/v1/auth/change-password
  body: json
  auth: bearer
}

headers {
  X-Tenant-Realm: {{PARTNER_TENANT_ID}}
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:json {
  {
    "currentPassword": "ChangeMe-12345!",
    "newPassword": "NewPassword-67890!"
  }
}
