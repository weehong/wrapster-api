meta {
  name: Get Token (Alpha Admin)
  type: http
  seq: 3
}

post {
  url: {{KEYCLOAK_URL}}/realms/{{ALPHA_REALM}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{CLIENT_ID}}
  client_secret: {{CLIENT_SECRET}}
  username: {{ALPHA_ADMIN_USERNAME}}
  password: {{ALPHA_ADMIN_PASSWORD}}
}

script:post-response {
  const body = res.getBody();
  bru.setVar("ACCESS_TOKEN", body.access_token);
  bru.setVar("TENANT_REALM", bru.getVar("ALPHA_REALM"));
}
