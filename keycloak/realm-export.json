{
  "id": "owner",
  "realm": "owner",
  "displayName": "Wrapsfer Owner Realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "user",
        "description": "Standard user role",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "wrapsfer-api",
      "name": "Wrapsfer API",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "wrapsfer-api-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:*",
        "https://localhost:*"
      ],
      "webOrigins": [
        "http://localhost:5000",
        "https://localhost:5001"
      ],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "wrapsfer-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "email": "testuser@wrapsfer.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "testpassword",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "user"
      ]
    },
    {
      "username": "owneradmin",
      "email": "owneradmin@wrapsfer.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Owner",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "owneradmin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "adminowner",
      "email": "adminowner@wrapsfer.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Owner",
      "credentials": [
        {
          "type": "password",
          "value": "adminowner",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
