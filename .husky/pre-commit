#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Run dotnet format on staged C# files
STAGED_CS_FOR_FORMAT=$(git diff --cached --name-only --diff-filter=ACM -- '*.cs' | grep -v '/obj/' || true)

if [ -n "$STAGED_CS_FOR_FORMAT" ]; then
    echo "Running dotnet format on staged files..."
    dotnet format --no-restore --include $STAGED_CS_FOR_FORMAT
    dotnet format style --no-restore --include $STAGED_CS_FOR_FORMAT

    # Re-stage formatted files
    for FILE in $STAGED_CS_FOR_FORMAT; do
        if [ -f "$FILE" ]; then
            git add "$FILE"
        fi
    done
fi

# Detect 'var' keyword usage in staged C# files
# Only checks added/modified lines in the diff to avoid flagging untouched code

STAGED_CS_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.cs' | grep -v '/obj/' || true)

if [ -z "$STAGED_CS_FILES" ]; then
    exit 0
fi

FOUND_VAR=0

for FILE in $STAGED_CS_FILES; do
    # Check only added lines (+) in the staged diff, skip diff headers (+++, @@)
    MATCHES=$(git diff --cached -U0 -- "$FILE" \
        | grep '^+' \
        | grep -v '^+++' \
        | grep -n '\bvar\b' || true)

    if [ -n "$MATCHES" ]; then
        if [ "$FOUND_VAR" -eq 0 ]; then
            echo ""
            echo "ERROR: DO NOT USE 'var' - use explicit types instead."
            echo ""
        fi
        FOUND_VAR=1
        echo "  $FILE:"
        echo "$MATCHES" | sed 's/^/    /'
        echo ""
    fi
done

if [ "$FOUND_VAR" -ne 0 ]; then
    echo "Commit rejected. Replace all 'var' declarations with explicit types."
    exit 1
fi

# Detect consecutive blank lines in staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -v '/obj/' | grep -v '/bin/' || true)

if [ -n "$STAGED_FILES" ]; then
    FOUND_BLANK=0

    for FILE in $STAGED_FILES; do
        # Use git show to read the staged version of the file
        # Look for 2+ consecutive blank lines (empty or whitespace-only)
        BLANK_LINES=$(git show ":$FILE" 2>/dev/null | grep -n '.' | awk -F: '
            NR > 1 {
                if ($1 - prev > 2) {
                    print prev+1 "-" $1-1
                }
                prev = $1
            }
            NR == 1 { prev = $1 }
        ' || true)

        if [ -n "$BLANK_LINES" ]; then
            if [ "$FOUND_BLANK" -eq 0 ]; then
                echo ""
                echo "ERROR: Multiple consecutive blank lines detected."
                echo ""
            fi
            FOUND_BLANK=1
            echo "  $FILE (blank line ranges):"
            echo "$BLANK_LINES" | sed 's/^/    lines /'
            echo ""
        fi
    done

    if [ "$FOUND_BLANK" -ne 0 ]; then
        echo "Commit rejected. Remove consecutive blank lines (max 1 allowed)."
        exit 1
    fi
fi
