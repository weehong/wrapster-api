# --- Image (overwritten by CI on deploy) ---
DOCKER_IMAGE=your-dockerhub-user/wrapster-api
IMAGE_TAG=latest

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
EXPECTED_SERVICES=3

# --- Database ---
DB_USER=wrapster
DB_PASSWORD=change-me
DB_NAME=wrapster
DB_CONNECTION_STRING=Host=db;Port=5432;Database=wrapster;Username=wrapster;Password=change-me

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=wrapster
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# --- Resend (Mailing) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@example.com
RESEND_FROM_NAME=Wrapster

# --- Keycloak ---
KEYCLOAK_BASE_URL=https://auth.example.com
KEYCLOAK_OWNER_REALM=owner
KEYCLOAK_AUDIENCE=wrapster-api
KEYCLOAK_REQUIRE_HTTPS=true
