# --- Image (overwritten by CI on deploy) ---
DOCKER_IMAGE=your-dockerhub-user/wrapsfer-api
IMAGE_TAG=latest

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
EXPECTED_SERVICES=5

# --- Database ---
DB_USER=wrapsfer
DB_PASSWORD=change-me
DB_NAME=wrapsfer
DB_CONNECTION_STRING=Host=db;Port=5432;Database=wrapsfer;Username=wrapsfer;Password=change-me

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=wrapsfer
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# --- Resend (Mailing) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@example.com
RESEND_FROM_NAME=Wrapsfer

# --- Keycloak (Production) ---
# BaseUrl is required and must be the public HTTPS Keycloak URL the API uses
# to validate JWT issuers. It MUST match the issuer Keycloak emits, which is
# derived from KC_HOSTNAME below.
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_OWNER_REALM=wrapsfer
KEYCLOAK_AUDIENCE=wrapsfer
KEYCLOAK_REQUIRE_HTTPS=true
KEYCLOAK_PARTNER_ONBOARDING_ENABLED=true
KEYCLOAK_ADMIN_CLIENT_ID=wrapsfer-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_REALM=master

# Shared API OIDC client secret for the `wrapsfer` client. Despite the setting
# name, this is used in both the owner realm and every provisioned partner
# realm. It is also substituted into keycloak/realm-export.json at import time.
KEYCLOAK_PARTNER_API_CLIENT_SECRET=change-me

# Initial password for the `wrapsfer` realm's seed `owneradmin` user.
# Substituted into keycloak/realm-export.json at import time. Must satisfy the
# realm password policy (>=12 chars, upper/lower/digit/special).
KEYCLOAK_OWNER_ADMIN_PASSWORD=change-me

# Public hostname Keycloak uses to construct issuer/iss claim and absolute URLs.
# Must be the same hostname clients (and the API) use to reach Keycloak.
KEYCLOAK_HOSTNAME=keycloak.example.com
KEYCLOAK_PROXY_HEADERS=xforwarded
KEYCLOAK_HOSTNAME_STRICT=true
KEYCLOAK_HOSTNAME_STRICT_HTTPS=true

KEYCLOAK_PORT=18080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# --- Infisical (runtime secret fetch) ---
# Machine-identity (Universal Auth) credentials the API uses at startup to pull
# secrets from Infisical. These three bootstrap values MUST be provided here —
# they cannot live in Infisical itself. Without them the provider logs
# "Infisical is not configured" and skips the fetch, leaving ReportStorage:S3:*
# (and other mapped secrets) blank, which fails ValidateOnStart in Production.
# The env slug is derived from ASPNETCORE_ENVIRONMENT (Production -> prod).
# Secrets fetched from Infisical: RESEND_API_KEY, REPORT_STORAGE_S3_BUCKET,
# REPORT_STORAGE_S3_REGION, REPORT_STORAGE_S3_PREFIX, REPORT_STORAGE_S3_TTL_MINUTES,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION, SHOPEE_PARTNER_ID,
# SHOPEE_PARTNER_KEY, SHOPEE_BASE_URL. See InfisicalSecretProvider.
Infisical__ClientId=change-me
Infisical__ClientSecret=change-me
Infisical__ProjectId=change-me

# --- Shopee Open Platform ---
# PartnerKey is fetched from Infisical (SHOPEE_PARTNER_KEY) at startup; PartnerId and
# BaseUrl can be set here or in Infisical (SHOPEE_PARTNER_ID / SHOPEE_BASE_URL).
# BaseUrl: https://partner.shopeemobile.com (live) or
# https://partner.test-stable.shopeemobile.com (sandbox).
Shopee__PartnerId=0
Shopee__BaseUrl=https://partner.shopeemobile.com

# --- Local development overrides ---
# Use these values when running locally with compose.dev.yaml (start-dev). Do not
# use them in Production — KEYCLOAK_REQUIRE_HTTPS=false and an http BaseUrl
# will be rejected by the API at startup.
#
# KEYCLOAK_BASE_URL=http://localhost:18080
# KEYCLOAK_REQUIRE_HTTPS=false
# KEYCLOAK_PARTNER_ONBOARDING_ENABLED=true
# KEYCLOAK_ADMIN_CLIENT_ID=wrapsfer-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=wrapsfer-admin-secret
# KEYCLOAK_PARTNER_API_CLIENT_SECRET=wrapsfer-secret
