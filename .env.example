# --- Image (overwritten by CI on deploy) ---
DOCKER_IMAGE=your-dockerhub-user/wrapsfer-api
IMAGE_TAG=latest

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
EXPECTED_SERVICES=5

# --- Database ---
DB_USER=wrapsfer
DB_PASSWORD=change-me
DB_NAME=wrapsfer
DB_CONNECTION_STRING=Host=db;Port=5432;Database=wrapsfer;Username=wrapsfer;Password=change-me

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=wrapsfer
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# --- Resend (Mailing) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@example.com
RESEND_FROM_NAME=Wrapsfer

# --- Keycloak (Production) ---
# BaseUrl is the public Keycloak URL the API uses to validate JWT issuers.
# It MUST match the issuer Keycloak emits, which is derived from KC_HOSTNAME
# below. In Production this must be https.
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_OWNER_REALM=wrapsfer
KEYCLOAK_AUDIENCE=wrapsfer
KEYCLOAK_REQUIRE_HTTPS=true
KEYCLOAK_PARTNER_ONBOARDING_ENABLED=true
KEYCLOAK_ADMIN_CLIENT_ID=wrapsfer-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_REALM=master

# Shared `wrapsfer` client secret. Embedded in every provisioned partner
# realm's `wrapsfer` client AND substituted into the main `wrapsfer` realm's
# client at import time (keycloak/realm-export.json). The API uses this when
# performing the password-grant login at POST /api/v1/auth/login.
KEYCLOAK_PARTNER_API_CLIENT_SECRET=change-me

# Initial password for the `wrapsfer` realm's seed `owneradmin` user.
# Substituted into keycloak/realm-export.json at import time. Must satisfy the
# realm password policy (>=12 chars, upper/lower/digit/special).
KEYCLOAK_OWNER_ADMIN_PASSWORD=change-me

# Public hostname Keycloak uses to construct issuer/iss claim and absolute URLs.
# Must be the same hostname clients (and the API) use to reach Keycloak.
KEYCLOAK_HOSTNAME=keycloak.example.com
KEYCLOAK_PROXY_HEADERS=xforwarded
KEYCLOAK_HOSTNAME_STRICT=true
KEYCLOAK_HOSTNAME_STRICT_HTTPS=true

KEYCLOAK_PORT=18080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# --- Local development overrides ---
# Use these values when running locally with compose.dev.yaml (start-dev). Do not
# use them in Production — KEYCLOAK_REQUIRE_HTTPS=false and an http BaseUrl
# will be rejected by the API at startup.
#
# KEYCLOAK_BASE_URL=http://localhost:18080
# KEYCLOAK_REQUIRE_HTTPS=false
