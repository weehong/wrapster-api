# --- Image (overwritten by CI on deploy) ---
DOCKER_IMAGE=your-dockerhub-user/wrapsfer-api
IMAGE_TAG=latest

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
EXPECTED_SERVICES=5

# --- Database ---
DB_USER=wrapsfer
DB_PASSWORD=change-me
DB_NAME=wrapsfer
DB_CONNECTION_STRING=Host=db;Port=5432;Database=wrapsfer;Username=wrapsfer;Password=change-me

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=wrapsfer
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# --- Resend (Mailing) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=noreply@example.com
RESEND_FROM_NAME=Wrapsfer

# --- Keycloak ---
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_OWNER_REALM=owner
KEYCLOAK_AUDIENCE=wrapsfer-api
KEYCLOAK_REQUIRE_HTTPS=false
KEYCLOAK_PORT=18080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
