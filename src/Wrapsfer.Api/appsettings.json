{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Cors": {
        "AllowedOrigins": ""
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{CorrelationId: [{CorrelationId}]} {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ]
    },
    "Keycloak": {
        "BaseUrl": "https://auth.domain.com",
        "OwnerRealm": "wrapsfer",
        "Audience": "wrapsfer",
        "RequireHttpsMetadata": true,
        "PartnerOnboardingEnabled": false,
        "AdminClientId": "",
        "AdminClientSecret": "",
        "AdminRealm": "master",
        "PartnerApiClientSecret": ""
    },
    "RabbitMq": {
        "HostName": "localhost",
        "Port": 5672,
        "UserName": "guest",
        "Password": "guest",
        "VirtualHost": "/"
    },
    "Mailing": {
        "Resend": {
            "ApiKey": "",
            "FromAddress": "noreply@wrapsfer.com",
            "FromName": "Wrapsfer"
        },
        "Queue": {
            "QueueName": "wrapsfer.mail",
            "MaxRetries": 3,
            "InitialBackoffSeconds": 1
        }
    },
    "PartnerIntegrations": {
        "ApiBaseUrl": ""
    },
    "ProductSettings": {
        "GlobalLowStockThreshold": 10,
        "LowStockReminderIntervalHours": 168,
        "MaxLowStockAlerts": 3
    },
    "ReportStorage": {
        "S3": {
            "BucketName": "",
            "Region": "",
            "Prefix": "reports",
            "DownloadUrlTtlMinutes": 4320
        }
    }
}
